<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <function model="website" name="write">
        <value eval="[ref('website.default_website')]"/>
        <value eval="{'homepage_url': '/salon'}"/>
    </function>

    <!-- Seeded explicitly (not left to the field's Python default) — an unset
         ir.config_parameter reads back as Python False, which a Settings toggle first being
         switched OFF also evaluates to, so res.config.settings.set_values() sees "no change"
         and silently skips the write unless a real string value ('True') is already stored
         to compare against. -->
    <record id="bsi_salon_theme_show_membership_param" model="ir.config_parameter">
        <field name="key">bsi_salon_theme.show_membership</field>
        <field name="value">True</field>
    </record>
    <record id="bsi_salon_theme_show_packages_param" model="ir.config_parameter">
        <field name="key">bsi_salon_theme.show_packages</field>
        <field name="value">True</field>
    </record>
    <record id="bsi_salon_theme_show_loyalty_points_param" model="ir.config_parameter">
        <field name="key">bsi_salon_theme.show_loyalty_points</field>
        <field name="value">True</field>
    </record>
    <record id="bsi_salon_theme_show_referral_param" model="ir.config_parameter">
        <field name="key">bsi_salon_theme.show_referral</field>
        <field name="value">True</field>
    </record>
    <record id="bsi_salon_theme_show_gift_card_param" model="ir.config_parameter">
        <field name="key">bsi_salon_theme.show_gift_card</field>
        <field name="value">True</field>
    </record>

</odoo>
