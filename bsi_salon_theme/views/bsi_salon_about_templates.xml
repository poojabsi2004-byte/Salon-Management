<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bsi_page_about" name="Salon Theme: About">
        <t t-call="bsi_salon_theme.bsi_layout">

            <!-- Hero -->
            <section class="bsi-section bsi-container bsi-about-hero">
                <div class="bsi-about-hero__col bsi-reveal">
                    <p class="bsi-eyebrow" t-esc="about_content.bsi_hero_eyebrow"/>
                    <h1 class="bsi-h1"><t t-esc="about_content.bsi_hero_title_line1"/><br/><em><t t-esc="about_content.bsi_hero_title_line2"/></em></h1>
                    <p class="bsi-lead" t-esc="about_content.bsi_story_paragraph_1"/>
                    <p class="bsi-lead" t-esc="about_content.bsi_story_paragraph_2"/>
                </div>
                <div class="bsi-about-hero__col bsi-about-hero__image bsi-reveal">
                    <img t-att-src="('/web/image/%s' % about_content.bsi_image_ids[0].id) if about_content.bsi_image_ids else (about_content.bsi_hero_image_url or 'https://images.unsplash.com/photo-1633681926022-84c23e8cb2d6?w=700&amp;h=800&amp;fit=crop&amp;auto=format')" alt="Stylist at work in salon"/>
                    <div class="bsi-about-hero__badge">
                        <div class="bsi-about-hero__badge-value" t-esc="about_content.bsi_badge_value"/>
                        <div class="bsi-about-hero__badge-label" t-esc="about_content.bsi_badge_label"/>
                    </div>
                </div>
            </section>



            <!-- Values -->
            <section class="bsi-section-alt bsi-section--pattern">
                <div class="bsi-side-pattern bsi-side-pattern--right" style="--bsi-side-pattern-h: 300px;" aria-hidden="true">
                </div>
                <div class="bsi-container bsi-container--above">
                    <div class="bsi-section__center bsi-reveal">
                        <p class="bsi-eyebrow">What We Stand For</p>
                        <h2 class="bsi-h2">Our principles.</h2>
                    </div>
                    <div class="bsi-grid-3">
                        <div t-foreach="values" t-as="value" class="bsi-card bsi-card--hover bsi-value-card bsi-reveal">
                            <div class="bsi-value-card__icon" t-esc="value.bsi_icon"/>
                            <h3 t-esc="value.name"/>
                            <p t-esc="value.bsi_description"/>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Team -->
            <section class="bsi-section bsi-container">
                <div class="bsi-section__head bsi-reveal">
                    <div>
                        <p class="bsi-eyebrow">The Team</p>
                        <h2 class="bsi-h2">Meet the artists.</h2>
                    </div>
                    <a href="/salon/stylists" class="bsi-link-arrow">All stylists →</a>
                </div>
                <div class="bsi-grid-4">
                    <div t-foreach="team_members" t-as="member" class="bsi-card bsi-card--hover bsi-team-card bsi-reveal">
                        <div class="bsi-team-card__media">
                            <img t-att-src="('/web/image/bsi.salon.team.member/%s/bsi_image' % member.id) if member.bsi_image else (member.bsi_image_url or 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=400&amp;h=500&amp;fit=crop&amp;auto=format')" t-att-alt="member.name"/>
                            <div class="bsi-team-card__scrim"/>
                            <span class="bsi-team-card__spec" t-esc="member.bsi_specialty"/>
                        </div>
                        <div class="bsi-team-card__body">
                            <div class="bsi-team-card__name" t-esc="member.name"/>
                            <div class="bsi-team-card__role" t-esc="member.bsi_role"/>
                            <div class="bsi-team-card__since">Since <t t-esc="member.bsi_since_year"/></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Awards -->
            <section class="bsi-section bsi-section--bordered-top bsi-section--pattern">
                <div class="bsi-side-pattern bsi-side-pattern--left" style="--bsi-side-pattern-h: 320px;" aria-hidden="true">
                </div>
                <div class="bsi-container bsi-container--above">
                    <div class="bsi-reveal">
                        <p class="bsi-eyebrow">Recognition</p>
                        <h2 class="bsi-h2">Award-winning work.</h2>
                    </div>
                    <div class="bsi-awards">
                        <div t-foreach="awards" t-as="award" class="bsi-award-row bsi-reveal">
                            <span class="bsi-award-row__year" t-esc="award.bsi_year"/>
                            <span class="bsi-award-row__title" t-esc="award.name"/>
                            <span class="bsi-award-row__mark">✦</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- CTA -->
            <section class="bsi-section bsi-section--bordered-top bsi-section__center">
                <h2 class="bsi-h2">Join the Enrich family.</h2>
                <div class="bsi-cta-row">
                    <a href="/salon/booking" class="bsi-btn bsi-btn--accent bsi-magnetic">Book Now</a>
                    <a href="/salon/packages" class="bsi-btn bsi-btn--outline bsi-magnetic">View Memberships</a>
                </div>
            </section>
        </t>
    </template>

</odoo>
