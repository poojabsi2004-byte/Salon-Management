<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bsi_salon_booking_request_view_form" model="ir.ui.view">
        <field name="name">bsi.salon.booking.request.form</field>
        <field name="model">bsi.salon.booking.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="oe_highlight" invisible="bsi_state != 'draft'"/>
                    <button name="action_pause" string="Pause" type="object"
                            invisible="bsi_state != 'started' or bsi_is_paused"/>
                    <button name="action_resume" string="Resume" type="object"
                            class="oe_highlight" invisible="bsi_state != 'started' or not bsi_is_paused"/>
                    <button name="action_end" string="End" type="object"
                            class="oe_highlight" invisible="bsi_state != 'started'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="bsi_state in ('completed', 'cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="bsi_state in ('draft', 'completed', 'cancelled')"/>
                    <field name="bsi_state" widget="statusbar" statusbar_visible="draft,started,ended,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_bsi_view_crm_lead" type="object"
                                class="oe_stat_button" icon="fa-handshake-o"
                                invisible="not bsi_crm_lead_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">CRM Lead</span>
                            </div>
                        </button>
                        <button name="action_bsi_view_quotation" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not bsi_sale_order_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Quotation</span>
                            </div>
                        </button>
                        <field name="bsi_invoice_count" invisible="1"/>
                        <button name="action_bsi_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="not bsi_invoice_count">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Invoices</span>
                            </div>
                        </button>
                        <field name="rating_avg" invisible="1" groups="base.group_user"/>
                        <button name="action_open_ratings" type="object" groups="base.group_user"
                                class="oe_stat_button" invisible="rating_count == 0">
                            <i class="fa fa-fw o_button_icon fa-smile-o text-success" invisible="rating_avg &lt; 3.66" title="Happy"/>
                            <i class="fa fa-fw o_button_icon fa-meh-o text-warning" invisible="rating_avg &lt; 2.33 or rating_avg &gt;= 3.66" title="Neutral"/>
                            <i class="fa fa-fw o_button_icon fa-frown-o text-danger" invisible="rating_avg &gt;= 2.33" title="Unhappy"/>
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="rating_avg_text" nolabel="1"/></span>
                                <span class="o_stat_text">Rating</span>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="bsi_partner_id" placeholder="Pick or create a customer..."/>
                            <field name="bsi_name"/>
                            <field name="bsi_email"/>
                            <field name="bsi_phone"/>
                            <field name="bsi_user_id"/>
                        </group>
                        <group string="City / Branch">
                            <field name="bsi_city"/>
                            <field name="bsi_location_id" domain="[('bsi_city', '=', bsi_city)]"/>
                        </group>
                    </group>
                    <group>
                        <group string="Team &amp; Branch">
                            <field name="bsi_chair_ids" widget="many2many_tags"
                                   domain="[('bsi_location_id', '=', bsi_location_id)]"/>
                            <field name="bsi_artist_id"
                                   domain="['|', ('bsi_location_id', '=', False), ('bsi_location_id', '=', bsi_location_id)]"/>
                            <field name="bsi_artist_charge_amount" readonly="1" invisible="bsi_package_id"/>
                        </group>
                        <group string="Date &amp; Time">
                            <field name="bsi_preferred_date"/>
                            <field name="bsi_use_slot" invisible="1"/>
                            <field name="bsi_use_custom_time"/>
                            <field name="bsi_slot_id" invisible="bsi_use_custom_time" required="not bsi_use_custom_time"/>
                            <field name="bsi_slot_start_time" widget="float_time" readonly="1" invisible="bsi_use_custom_time"/>
                            <field name="bsi_slot_end_time" widget="float_time" readonly="1" invisible="bsi_use_custom_time"/>
                            <field name="bsi_preferred_time" widget="float_time" invisible="not bsi_use_custom_time" required="bsi_use_custom_time"/>
                            <field name="bsi_is_paused" invisible="1"/>
                            <field name="bsi_started_at" readonly="1" invisible="not bsi_started_at"/>
                            <field name="bsi_paused_at" readonly="1" invisible="not bsi_is_paused"/>
                            <field name="bsi_ended_at" readonly="1" invisible="not bsi_ended_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="bsi_packages_enabled" invisible="1"/>
                        <field name="bsi_package_id" invisible="not bsi_packages_enabled"/>
                    </group>
                    <!-- There are two renderings of this field: editable for individual
                         services and read-only for a selected package.  Give each one a
                         matching label so the label remains visible in either state. -->
                    <label for="bsi_service_ids" string="Services" invisible="bsi_package_id"/>
                    <field name="bsi_service_ids" widget="many2many_tags" invisible="bsi_package_id"
                           required="not bsi_package_id"/>
                    <label for="bsi_service_ids" string="Services" invisible="not bsi_package_id"/>
                    <field name="bsi_service_ids" widget="many2many_tags" readonly="1" invisible="not bsi_package_id"/>
                    <group>
                        <group string="Pricing">
                            <field name="bsi_services_amount" readonly="1"/>
                            <field name="bsi_amount_total" readonly="1"/>
                            <field name="bsi_has_membership" invisible="1"/>
                            <field name="bsi_membership_feature_enabled" invisible="1"/>
                            <field name="bsi_is_member" invisible="not bsi_membership_feature_enabled or not bsi_has_membership"/>
                            <!-- Config-based, same gate as the checkbox above: hidden
                                 entirely when Settings > Salon Management > Show Membership
                                 is off, regardless of whether a membership was verified. -->
                            <field name="bsi_membership_id" string="Membership Plan" readonly="1"
                                   invisible="not bsi_membership_feature_enabled or not bsi_membership_id"/>
                            <field name="bsi_discount_percent" string="Membership Discount %" readonly="1"
                                   invisible="not bsi_membership_feature_enabled or not bsi_membership_id"/>
                            <field name="bsi_membership_perks" string="Plan Includes" readonly="1"
                                   invisible="not bsi_membership_feature_enabled or not bsi_membership_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Services" name="bsi_services_tab">
                            <!-- Before the visit Starts, bsi_service_line_ids doesn't exist
                                 yet (see action_start/_bsi_create_service_lines), so the
                                 plain service list below is what's shown; once it does exist
                                 it replaces that list with the same services plus their live
                                 Start/End timing — one tab either way, never both at once. -->
                            <field name="bsi_service_ids" readonly="1" invisible="bsi_service_line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="bsi_category"/>
                                    <field name="bsi_duration"/>
                                    <field name="bsi_price_amount" string="Price"/>
                                </list>
                            </field>
                            <field name="bsi_service_line_ids" readonly="1" invisible="not bsi_service_line_ids">
                                <list create="false" delete="false">
                                    <field name="bsi_service_id" string="Service"/>
                                    <field name="bsi_service_category" string="Category"/>
                                    <field name="bsi_service_duration_label" string="Duration Label"/>
                                    <field name="bsi_service_price" string="Price"/>
                                    <field name="bsi_state" widget="badge" string="Status"
                                           decoration-muted="bsi_state == 'not_started'"
                                           decoration-warning="bsi_state == 'started'"
                                           decoration-success="bsi_state == 'ended'"/>
                                    <field name="bsi_start_time"/>
                                    <field name="bsi_end_time"/>
                                    <field name="bsi_duration_minutes" string="Total Time (min)"/>
                                    <button name="action_start_service" string="Start" type="object"
                                            icon="fa-play" class="btn btn-sm btn-primary"
                                            invisible="bsi_state != 'not_started'"/>
                                    <button name="action_end_service" string="End" type="object"
                                            icon="fa-stop" class="btn btn-sm btn-outline-danger"
                                            invisible="bsi_state != 'started'"/>
                                </list>
                            </field>
                        </page>
                        <!-- Only meaningful once the visit is actually Done (which itself only
                             happens once the invoice is fully paid — see action_complete) —
                             matches the same gating as the Sale Order's "Add Review" button
                             and the portal's own review form. -->
                        <page string="Reviews &amp; Ratings" name="bsi_ratings" invisible="bsi_state != 'completed'">
                            <button name="action_bsi_add_review" type="object" string="Add Review"
                                    class="btn-secondary mb-2"/>
                            <field name="rating_ids" readonly="1">
                                <list>
                                    <field name="partner_id" string="Reviewer"/>
                                    <field name="bsi_rating_stars" widget="priority" string="Overall"/>
                                    <field name="bsi_artist_id" string="Artist"/>
                                    <field name="bsi_artist_rating_stars" widget="priority" string="Artist Rating"/>
                                    <field name="feedback" string="Comment"/>
                                    <field name="rated_on"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="bsi_notes">
                            <field name="bsi_notes" placeholder="Additional notes..."/>
                        </page>
                        <page string="Legacy Website Fields" name="bsi_legacy">
                            <group>
                                <field name="bsi_service"/>
                                <field name="bsi_chair_no"/>
                                <field name="bsi_time_slot"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bsi_salon_booking_request_view_list" model="ir.ui.view">
        <field name="name">bsi.salon.booking.request.list</field>
        <field name="model">bsi.salon.booking.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="bsi_preferred_date"/>
                <field name="bsi_slot_id"/>
                <field name="bsi_use_custom_time" optional="hide"/>
                <field name="bsi_name"/>
                <field name="bsi_city" optional="hide"/>
                <field name="bsi_location_id"/>
                <field name="bsi_service_ids" widget="many2many_tags"/>
                <field name="bsi_artist_id"/>
                <field name="bsi_amount_total" sum="Total"/>
                <field name="bsi_user_id"/>
                <field name="create_date" optional="hide"/>
                <field name="rating_last_text" string="Rating" widget="badge" optional="hide"
                       decoration-danger="rating_last_text == 'ko'" decoration-warning="rating_last_text == 'ok'"
                       decoration-success="rating_last_text == 'top'" invisible="rating_last_text == 'none'"/>
                <field name="bsi_state" widget="badge" decoration-info="bsi_state == 'draft'"
                       decoration-warning="bsi_state in ('started', 'ended')" decoration-success="bsi_state == 'completed'"
                       decoration-danger="bsi_state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="bsi_salon_booking_request_view_search" model="ir.ui.view">
        <field name="name">bsi.salon.booking.request.search</field>
        <field name="model">bsi.salon.booking.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="bsi_name" string="Booking"/>
                <field name="bsi_email"/>
                <field name="bsi_partner_id"/>
                <field name="bsi_location_id"/>
                <field name="bsi_service_ids"/>
                <field name="bsi_package_id"/>
                <field name="bsi_artist_id"/>
                <field name="bsi_slot_id"/>
                <field name="bsi_user_id"/>
                <filter string="My Bookings" name="bsi_filter_my" domain="[('bsi_user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="bsi_filter_draft" domain="[('bsi_state', '=', 'draft')]"/>
                <filter string="Started" name="bsi_filter_started" domain="[('bsi_state', '=', 'started')]"/>
                <filter string="Ended" name="bsi_filter_ended" domain="[('bsi_state', '=', 'ended')]"/>
                <filter string="Done" name="bsi_filter_completed" domain="[('bsi_state', '=', 'completed')]"/>
                <filter string="Cancelled" name="bsi_filter_cancelled" domain="[('bsi_state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Fixed Slot" name="bsi_filter_use_slot" domain="[('bsi_use_slot', '=', True)]"/>
                <separator/>
                <!-- Used by the Salon Dashboard's "Today's Bookings"/"Completed Services" KPI
                     cards (search_default_ in their action's context, see
                     bsi_salon_dashboard_kpi_actions.xml) so clicking one shows a visible,
                     removable "Today" chip instead of an invisible base domain. -->
                <filter string="Today" name="bsi_filter_today" domain="[('bsi_preferred_date', '=', context_today())]"/>
                <filter string="Completed Today" name="bsi_filter_completed_today"
                        domain="[('bsi_state', '=', 'completed'), ('bsi_ended_at', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00')), ('bsi_ended_at', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter string="Assigned To" name="bsi_group_user" context="{'group_by': 'bsi_user_id'}"/>
                    <filter string="Branch" name="bsi_group_location" context="{'group_by': 'bsi_location_id'}"/>
                    <filter string="Artist" name="bsi_group_artist" context="{'group_by': 'bsi_artist_id'}"/>
                    <filter string="Status" name="bsi_group_state" context="{'group_by': 'bsi_state'}"/>
                    <filter string="Booking Date" name="bsi_group_date" context="{'group_by': 'bsi_preferred_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bsi_salon_booking_request_view_kanban" model="ir.ui.view">
        <field name="name">bsi.salon.booking.request.kanban</field>
        <field name="model">bsi.salon.booking.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="bsi_state" quick_create="false" class="bsi-booking-kanban">
                <field name="bsi_state"/>
                <field name="bsi_amount_total"/>
                <field name="bsi_partner_id"/>
                <field name="bsi_artist_id"/>
                <progressbar field="bsi_state" colors='{"draft": "muted", "started": "info", "ended": "info", "completed": "success", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_global_click bsi-booking-card bsi-booking-card--#{record.bsi_state.raw_value}">
                            <div class="bsi-booking-card__top">
                                <div class="bsi-booking-card__customer">
                                    <img t-if="record.bsi_partner_id.raw_value" class="bsi-booking-card__avatar"
                                         t-att-src="'/web/image/res.partner/' + record.bsi_partner_id.raw_value + '/avatar_128'" alt="Customer"/>
                                    <span t-else="" class="bsi-booking-card__avatar bsi-booking-card__avatar--placeholder">
                                        <i class="fa fa-user"/>
                                    </span>
                                    <span class="bsi-booking-card__name"><field name="bsi_name"/></span>
                                </div>
                                <field name="rating_last_text" widget="badge"
                                       decoration-danger="rating_last_text == 'ko'" decoration-warning="rating_last_text == 'ok'"
                                       decoration-success="rating_last_text == 'top'" invisible="rating_last_text == 'none'"/>
                            </div>
                            <div class="bsi-booking-card__services">
                                <field name="bsi_service_ids" widget="many2many_tags"/>
                            </div>
                            <div class="bsi-booking-card__meta">
                                <span class="bsi-booking-card__artist">
                                    <img t-if="record.bsi_artist_id.raw_value" class="bsi-booking-card__artist-avatar"
                                         t-att-src="'/web/image/bsi.salon.team.member/' + record.bsi_artist_id.raw_value + '/bsi_image'" alt="Artist"/>
                                    <i t-else="" class="fa fa-user-o"/>
                                    <field name="bsi_artist_id"/>
                                </span>
                                <span><i class="fa fa-calendar-o me-1"/><field name="bsi_preferred_date"/></span>
                            </div>
                            <div class="bsi-booking-card__footer">
                                <field name="bsi_location_id" class="bsi-booking-card__location"/>
                                <span class="bsi-booking-card__amount"><field name="bsi_amount_total"/></span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="bsi_salon_booking_request_view_graph" model="ir.ui.view">
        <field name="name">bsi.salon.booking.request.graph</field>
        <field name="model">bsi.salon.booking.request</field>
        <field name="arch" type="xml">
            <graph string="Bookings" type="bar">
                <field name="bsi_preferred_date" type="row" interval="week"/>
                <field name="bsi_state" type="col"/>
                <field name="bsi_amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="bsi_salon_booking_request_view_pivot" model="ir.ui.view">
        <field name="name">bsi.salon.booking.request.pivot</field>
        <field name="model">bsi.salon.booking.request</field>
        <field name="arch" type="xml">
            <pivot string="Bookings">
                <field name="bsi_artist_id" type="row"/>
                <field name="bsi_location_id" type="row"/>
                <field name="bsi_state" type="col"/>
                <field name="bsi_amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="bsi_salon_booking_request_view_activity" model="ir.ui.view">
        <field name="name">bsi.salon.booking.request.activity</field>
        <field name="model">bsi.salon.booking.request</field>
        <field name="arch" type="xml">
            <activity string="Bookings">
                <field name="bsi_name"/>
                <field name="bsi_artist_id"/>
                <field name="bsi_preferred_date"/>
                <templates>
                    <div t-name="activity-box">
                        <img t-att-src="activity_image('res.partner', 'avatar_128', record.bsi_partner_id.raw_value)" alt="Customer avatar" class="rounded-circle"/>
                        <div class="ms-2">
                            <field name="bsi_name" display="full" class="o_text_block"/>
                            <field name="bsi_artist_id" muted="1" display="full"/>
                            <field name="bsi_preferred_date" muted="1" display="full"/>
                        </div>
                    </div>
                </templates>
            </activity>
        </field>
    </record>

    <record id="bsi_salon_booking_request_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">bsi.salon.booking.request</field>
        <field name="view_mode">kanban,list,graph,pivot,activity,form</field>
        <field name="search_view_id" ref="bsi_salon_booking_request_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a new booking</p>
            <p>Pick a city, branch, services, chair and artist, then Start the visit — Ending
               it opens a quotation, which becomes Done automatically once fully paid.</p>
        </field>
    </record>

    <menuitem id="bsi_salon_theme_root_menu" name="Salon Management" sequence="15"/>
    <!-- Reuses CRM's own "My Pipeline" action (kanban grouped by stage, same one CRM's own
         top menu points to) so leads can be marked Won right from here — that's what
         creates the appointment (see crm_lead.py:_bsi_create_appointment_from_lead) —
         without leaving the Salon Management app for the separate CRM app. -->
    <!-- Sidebar shows this under the "Marketing" icon/label (see dashboard.py
         _SIDEBAR_LABELS) — its own name here is left as "CRM" since that's still how it
         reads everywhere else in the backend (breadcrumb, Configuration menu, etc). -->
    <menuitem id="bsi_salon_crm_pipeline_menu" name="CRM" parent="bsi_salon_theme_root_menu"
              action="crm.action_your_pipeline" sequence="2"/>
    <menuitem id="bsi_salon_booking_request_menu" name="Bookings" parent="bsi_salon_theme_root_menu" action="bsi_salon_booking_request_action" sequence="3"/>

</odoo>
