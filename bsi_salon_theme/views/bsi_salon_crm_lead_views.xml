<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bsi_crm_lead_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.bsi.salon</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='active']" position="after">
                <field name="bsi_appointment_id" invisible="1"/>
                <field name="bsi_appointment_state" invisible="1"/>
                <field name="bsi_stage_is_won" invisible="1"/>
            </xpath>

            <!-- Leads generated from a salon appointment skip the regular "New Quotation"
                 shortcut, which is hidden for them — the quotation itself is only generated
                 later, once the appointment visit actually Ends, so it always reflects
                 whatever was really delivered rather than what was booked. -->
            <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                <attribute name="invisible">type == 'lead' or (probability == 0 and not active) or bsi_appointment_id</attribute>
            </xpath>
            <xpath expr="//button[@name='action_sale_quotations_new']" position="after">
                <button name="action_bsi_retry_appointment" string="Retry Booking" type="object"
                        class="oe_highlight"
                        title="The chair/artist/slot was taken by the time this lead was Won and the customer was emailed — once you've picked a new one below, retry creating the appointment here."
                        invisible="not bsi_stage_is_won or bsi_appointment_id"/>
            </xpath>

            <div name="button_box" position="inside">
                <button name="action_bsi_view_appointment" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        invisible="not bsi_appointment_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Booking</span>
                    </div>
                </button>
            </div>

            <!-- Booking details entered on the website (or by staff, for a phone-in booking)
                 — editable up until this lead is Won, at which point they're copied 1:1 into
                 the appointment that gets created and become read-only mirrors of it instead,
                 so nobody accidentally edits a lead's stale copy after the real record exists. -->
            <xpath expr="//notebook" position="inside">
                <page name="bsi_appointment_details" string="Booking Details">
                    <group>
                        <group string="Booking">
                            <field name="bsi_city" readonly="bsi_appointment_id" required="bsi_stage_is_won and not bsi_appointment_id"/>
                            <field name="bsi_location_id" domain="[('bsi_city', '=', bsi_city)]"
                                   readonly="bsi_appointment_id" required="bsi_stage_is_won and not bsi_appointment_id"/>
                            <field name="bsi_artist_id" readonly="bsi_appointment_id"
                                   domain="['|', ('bsi_location_id', '=', False), ('bsi_location_id', '=', bsi_location_id)]"/>
                            <field name="bsi_chair_ids" widget="many2many_tags" readonly="bsi_appointment_id"
                                   domain="[('bsi_location_id', '=', bsi_location_id)]"/>
                            <field name="bsi_preferred_date" readonly="bsi_appointment_id" required="bsi_stage_is_won and not bsi_appointment_id"/>
                            <field name="bsi_use_slot" invisible="1"/>
                            <field name="bsi_use_custom_time" readonly="bsi_appointment_id"/>
                            <field name="bsi_slot_id" readonly="bsi_appointment_id" invisible="bsi_use_custom_time"
                                   required="bsi_stage_is_won and not bsi_use_custom_time and not bsi_appointment_id"/>
                            <field name="bsi_preferred_time" widget="float_time" readonly="bsi_appointment_id" invisible="not bsi_use_custom_time"
                                   required="bsi_stage_is_won and bsi_use_custom_time and not bsi_appointment_id"/>
                            <field name="bsi_appointment_time" invisible="not bsi_appointment_id"/>
                            <field name="bsi_appointment_state" invisible="not bsi_appointment_id"/>
                        </group>
                        <group string="Services &amp; Pricing">
                            <field name="bsi_packages_enabled" invisible="1"/>
                            <field name="bsi_membership_feature_enabled" invisible="1"/>
                            <field name="bsi_has_membership" invisible="1"/>
                            <field name="bsi_package_id" readonly="bsi_appointment_id" invisible="not bsi_packages_enabled"/>
                            <field name="bsi_service_ids" widget="many2many_tags"
                                   readonly="bsi_appointment_id" invisible="bsi_package_id"
                                   required="bsi_stage_is_won and not bsi_package_id and not bsi_appointment_id"/>
                            <field name="bsi_service_ids" widget="many2many_tags" readonly="1" invisible="not bsi_package_id"/>
                            <field name="bsi_services_amount"/>
                            <field name="bsi_amount_total"/>
                            <field name="bsi_is_member" readonly="bsi_appointment_id"
                                   invisible="not bsi_membership_feature_enabled or not bsi_has_membership"/>
                            <!-- Only ever shown once bsi_membership_id is actually set — i.e.
                                 genuinely verified against an active subscription, not just
                                 ticked (see bsi_is_member's help text) — and only while the
                                 Settings > Salon Management > Show Membership toggle is on,
                                 same gate as the checkbox above. -->
                            <field name="bsi_membership_id" string="Membership Plan" readonly="1"
                                   invisible="not bsi_membership_feature_enabled or not bsi_membership_id"/>
                            <field name="bsi_discount_percent" string="Membership Discount %" readonly="1"
                                   invisible="not bsi_membership_feature_enabled or not bsi_membership_id"/>
                            <field name="bsi_membership_perks" string="Plan Includes" readonly="1"
                                   invisible="not bsi_membership_feature_enabled or not bsi_membership_id"/>
                        </group>
                    </group>
                    <field name="bsi_notes" placeholder="Notes..." readonly="bsi_appointment_id"/>
                    <field name="bsi_reference_image" widget="image" class="oe_avatar" invisible="not bsi_reference_image"/>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
