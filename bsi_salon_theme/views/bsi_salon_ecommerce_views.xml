<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reuses website_sale's own "Products" action (kanban/list/form tuned for the
         website shop, Published filter, categories, ...) so products added here behave
         exactly like products managed from the Website app's eCommerce menu. Single flat
         top-level menu — no "eCommerce" wrapper. -->
    <menuitem id="bsi_salon_ecommerce_product_menu" name="Product" parent="bsi_salon_theme_root_menu"
              action="website_sale.product_template_action_website" sequence="4"/>

</odoo>
