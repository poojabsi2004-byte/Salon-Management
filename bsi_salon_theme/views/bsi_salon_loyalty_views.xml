<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bsi_salon_loyalty_point_view_list" model="ir.ui.view">
        <field name="name">bsi.salon.loyalty.point.list</field>
        <field name="model">bsi.salon.loyalty.point</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="create_date" string="Date"/>
                <field name="bsi_partner_id"/>
                <field name="bsi_reason" widget="badge"
                       decoration-success="bsi_reason == 'referral'"/>
                <field name="name"/>
                <field name="bsi_referred_partner_id" optional="hide"/>
                <field name="bsi_appointment_id" optional="hide"/>
                <field name="bsi_points" sum="Total Points"/>
            </list>
        </field>
    </record>

    <record id="bsi_salon_loyalty_point_view_search" model="ir.ui.view">
        <field name="name">bsi.salon.loyalty.point.search</field>
        <field name="model">bsi.salon.loyalty.point</field>
        <field name="arch" type="xml">
            <search>
                <field name="bsi_partner_id"/>
                <filter string="Booking Points" name="bsi_filter_appointment" domain="[('bsi_reason', '=', 'appointment')]"/>
                <filter string="Referral Bonuses" name="bsi_filter_referral" domain="[('bsi_reason', '=', 'referral')]"/>
                <group>
                    <filter string="Customer" name="bsi_group_partner" context="{'group_by': 'bsi_partner_id'}"/>
                    <filter string="Reason" name="bsi_group_reason" context="{'group_by': 'bsi_reason'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bsi_salon_loyalty_point_action" model="ir.actions.act_window">
        <field name="name">Loyalty Points</field>
        <field name="res_model">bsi.salon.loyalty.point</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="bsi_salon_loyalty_point_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No loyalty points earned yet</p>
            <p>Points are earned automatically — 1 to 20 once a customer's appointment is
               marked Done and its invoice is fully paid, plus a 100-point referral bonus to
               whoever referred them, on that same customer's first such visit.</p>
        </field>
    </record>

    <!-- Grouped with customer-facing loyalty tools under Configuration. -->
    <menuitem id="bsi_salon_loyalty_point_menu" name="Loyalty Points"
              parent="bsi_salon_customer_management_menu" action="bsi_salon_loyalty_point_action" sequence="20"/>

    <record id="bsi_salon_referral_wizard_view_form" model="ir.ui.view">
        <field name="name">bsi.salon.referral.wizard.form</field>
        <field name="model">bsi.salon.referral.wizard</field>
        <field name="arch" type="xml">
            <form string="Refer a Friend">
                <group>
                    <field name="partner_id" readonly="1"/>
                    <field name="bsi_loyalty_points" readonly="1"/>
                    <field name="bsi_referral_code" readonly="1"/>
                    <field name="bsi_referral_link" readonly="1"/>
                </group>
                <p class="text-muted">
                    Share this code with a friend — once they book their first appointment
                    through it and their invoice is fully paid, you earn 100 loyalty points.
                </p>
                <footer>
                    <button name="action_share_whatsapp" string="Share via WhatsApp" type="object"
                            class="btn-primary" icon="fa-whatsapp"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="bsi_salon_referral_wizard_action" model="ir.actions.act_window">
        <field name="name">Refer a Friend</field>
        <field name="res_model">bsi.salon.referral.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="bsi_salon_referral_wizard_menu" name="Refer a Friend"
              parent="bsi_salon_customer_management_menu" action="bsi_salon_referral_wizard_action" sequence="30"/>

    <!-- Loyalty balance + referral info, surfaced on the standard Contact form so staff
         don't need a separate screen just to check a customer's points or referral code. -->
    <record id="bsi_res_partner_view_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.bsi.salon</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('mb8')]" position="after">
                <group string="Salon Loyalty" col="4" invisible="not bsi_loyalty_points and not bsi_referral_code and not bsi_referred_by_id">
                    <field name="bsi_loyalty_points" readonly="1"/>
                    <field name="bsi_referral_code" readonly="1"/>
                    <field name="bsi_referred_by_id" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="%(bsi_salon_booking_request_action)d" type="action"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        context="{'search_default_bsi_partner_id': id}"
                        invisible="not bsi_booking_count">
                    <field name="bsi_booking_count" widget="statinfo" string="Appointments"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Bookings" name="bsi_bookings_tab" invisible="not bsi_booking_count">
                    <field name="bsi_booking_ids" readonly="1">
                        <list>
                            <field name="bsi_preferred_date"/>
                            <field name="bsi_service_ids" widget="many2many_tags"/>
                            <field name="bsi_artist_id"/>
                            <field name="bsi_location_id"/>
                            <field name="bsi_amount_total" sum="Total"/>
                            <field name="bsi_state" widget="badge"
                                   decoration-info="bsi_state == 'draft'"
                                   decoration-warning="bsi_state in ('started', 'ended')"
                                   decoration-success="bsi_state == 'completed'"
                                   decoration-danger="bsi_state == 'cancelled'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
