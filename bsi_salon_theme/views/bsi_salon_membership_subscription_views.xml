<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bsi_salon_membership_subscription_view_list" model="ir.ui.view">
        <field name="name">bsi.salon.membership.subscription.list</field>
        <field name="model">bsi.salon.membership.subscription</field>
        <field name="arch" type="xml">
            <list decoration-info="bsi_state == 'draft'" decoration-success="bsi_state == 'active'"
                  decoration-danger="bsi_state == 'expired'" decoration-muted="bsi_state == 'cancelled'">
                <field name="bsi_partner_id"/>
                <field name="bsi_membership_id"/>
                <field name="bsi_billing_period"/>
                <field name="bsi_start_date"/>
                <field name="bsi_end_date"/>
                <field name="bsi_amount_paid" sum="Total"/>
                <field name="bsi_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="bsi_salon_membership_subscription_view_form" model="ir.ui.view">
        <field name="name">bsi.salon.membership.subscription.form</field>
        <field name="model">bsi.salon.membership.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="oe_highlight" invisible="bsi_state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="bsi_state in ('cancelled',)"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="bsi_state in ('draft', 'cancelled')"/>
                    <field name="bsi_state" widget="statusbar" statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="bsi_partner_id"/>
                            <field name="bsi_membership_id"/>
                            <field name="bsi_billing_period"/>
                        </group>
                        <group>
                            <field name="bsi_start_date" readonly="bsi_state != 'draft'"/>
                            <field name="bsi_end_date" readonly="1"/>
                            <field name="bsi_amount_paid"/>
                            <field name="bsi_sale_order_id" invisible="not bsi_sale_order_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="bsi_salon_membership_subscription_view_search" model="ir.ui.view">
        <field name="name">bsi.salon.membership.subscription.search</field>
        <field name="model">bsi.salon.membership.subscription</field>
        <field name="arch" type="xml">
            <search>
                <field name="bsi_partner_id"/>
                <field name="bsi_membership_id"/>
                <filter string="Draft" name="bsi_filter_draft" domain="[('bsi_state', '=', 'draft')]"/>
                <filter string="Active" name="bsi_filter_active" domain="[('bsi_state', '=', 'active')]"/>
                <filter string="Expired" name="bsi_filter_expired" domain="[('bsi_state', '=', 'expired')]"/>
                <filter string="Cancelled" name="bsi_filter_cancelled" domain="[('bsi_state', '=', 'cancelled')]"/>
                <group>
                    <filter string="Tier" name="bsi_group_membership" context="{'group_by': 'bsi_membership_id'}"/>
                    <filter string="Status" name="bsi_group_state" context="{'group_by': 'bsi_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bsi_salon_membership_subscription_action" model="ir.actions.act_window">
        <field name="name">Membership Subscriptions</field>
        <field name="res_model">bsi.salon.membership.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="bsi_salon_membership_subscription_view_search"/>
    </record>

    <!-- Grouped under Configuration -> Membership (see bsi_salon_content_views.xml) alongside
         the Memberships (tiers) menu. -->
    <menuitem id="bsi_salon_membership_subscription_menu" name="Membership Subscriptions"
              parent="bsi_salon_membership_group_menu" action="bsi_salon_membership_subscription_action" sequence="20"/>

</odoo>
