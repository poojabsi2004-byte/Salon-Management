<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bsi_page_packages" name="Salon Theme: Packages">
        <t t-call="bsi_salon_theme.bsi_layout">

            <!-- Hero -->
            <section class="bsi-container bsi-page-hero bsi-section--bordered-bottom bsi-reveal">
                <p class="bsi-eyebrow">Membership</p>
                <h1 class="bsi-h1">One membership,<br/><em>every branch, every city.</em></h1>
            </section>

            <!-- Memberships -->
            <section t-if="show_membership" class="bsi-container bsi-section">
                <div class="bsi-packages-head bsi-reveal">
                    <div>
                        <h2 class="bsi-h2">Choose your tier.</h2>
                        <p class="bsi-muted">Cancel anytime. No hidden fees.</p>
                    </div>
                    <div class="bsi-billing-toggle" id="bsiBillingToggle">
                        <button type="button" class="bsi-billing-toggle__btn bsi-billing-toggle__btn--active" data-billing="monthly">Monthly</button>
                        <button type="button" class="bsi-billing-toggle__btn" data-billing="yearly">Yearly <span class="bsi-billing-toggle__badge">Save 25%</span></button>
                    </div>
                </div>

                <div class="bsi-grid-3">
                    <div t-foreach="memberships" t-as="m" t-attf-class="bsi-card bsi-membership-card bsi-card--hover bsi-reveal #{m.bsi_featured and 'bsi-membership-card--featured' or ''}">
                        <div t-if="m.bsi_featured" class="bsi-membership-card__ribbon">Most Popular</div>
                        <h3 t-esc="m.name"/>
                        <p class="bsi-membership-card__tagline" t-esc="m.bsi_tagline"/>
                        <div class="bsi-membership-card__price">
                            <span class="bsi-membership-card__price-value" t-att-data-monthly="'₹%d' % m.bsi_price_monthly" t-att-data-yearly="'₹%d' % m.bsi_price_yearly" t-esc="'₹%d' % m.bsi_price_monthly"/>
                            <span class="bsi-membership-card__price-unit" data-monthly-unit="/month"
                                  data-yearly-unit="/mo, billed yearly">/month</span>
                        </div>
                        <ul class="bsi-membership-card__perks">
                            <li t-foreach="(m.bsi_perks or '').split('\n')" t-as="perk" t-if="perk.strip()">
                                <span class="bsi-check">✓</span><t t-esc="perk"/>
                            </li>
                        </ul>
                        <button type="button" class="bsi-btn bsi-btn--block bsi-membership-cta"
                                t-att-data-membership-id="m.id"
                                t-esc="m.bsi_cta_label or ('Choose %s' % m.name)"/>
                    </div>
                </div>
            </section>

            
            <!-- Loyalty wallet + gift cards -->
            <section t-if="show_loyalty_points or show_gift_card" class="bsi-section bsi-section--bordered-top">
                <div class="bsi-container bsi-grid-2">
                    <div t-if="show_loyalty_points" class="bsi-wallet-card">
                        <p class="bsi-eyebrow bsi-eyebrow--on-accent">Loyalty Wallet</p>
                        <h3 class="bsi-h3">1,240 points</h3>
                        <p class="bsi-muted">Earn 1 point per ₹10 spent · redeem points for services or products. Worth ₹620 today.</p>
                    </div>
                    <div t-if="show_gift_card" class="bsi-card bsi-giftcards-card">
                        <p class="bsi-eyebrow">Gift Cards</p>
                        <h3 class="bsi-h3">Give the gift of Enrich.</h3>
                        <div class="bsi-tag-list bsi-mb-lg">
                            <span class="bsi-tag-outline">₹500</span>
                            <span class="bsi-tag-outline">₹1,000</span>
                            <span class="bsi-tag-outline">₹2,500</span>
                            <span class="bsi-tag-outline">₹5,000</span>
                        </div>
                        <a href="/salon/contact" class="bsi-btn bsi-btn--accent bsi-magnetic">Buy a Gift Card</a>
                    </div>
                </div>
            </section>

            <!-- Bundle packages -->
            <section t-if="show_packages" class="bsi-section bsi-section--bordered-top">
                <div class="bsi-container">
                    <div class="bsi-reveal">
                        <p class="bsi-eyebrow">Bundle &amp; Save</p>
                        <h2 class="bsi-h2">Curated packages.</h2>
                        <p class="bsi-muted bsi-mb-lg">Handpicked combinations for every occasion. Better together.</p>
                    </div>
                    <t t-set="package_fallbacks" t-value="['https://images.unsplash.com/photo-1560869713-7d0a29430803?w=600&amp;h=600&amp;fit=crop&amp;auto=format&amp;q=80', 'https://images.unsplash.com/photo-1522337660859-02fbefca4702?w=600&amp;h=600&amp;fit=crop&amp;auto=format&amp;q=80', 'https://images.unsplash.com/photo-1560066984-138dadb4c035?w=600&amp;h=600&amp;fit=crop&amp;auto=format&amp;q=80']"/>
                    <div class="bsi-grid-2">
                        <a t-foreach="packages" t-as="p" href="/salon/booking" class="bsi-card bsi-card--hover bsi-package-card bsi-reveal">
                            <div class="bsi-package-card__media">
                                <img t-att-src="('/web/image/%s' % p.bsi_image_ids[0].id) if p.bsi_image_ids else (p.bsi_image_url or package_fallbacks[p_index % len(package_fallbacks)])" t-att-alt="p.name"/>
                            </div>
                            <div class="bsi-package-card__body">
                                <div class="bsi-package-card__head">
                                    <h3 t-esc="p.name"/>
                                    <span class="bsi-tag-accent bsi-tag-accent--sm" t-esc="p.bsi_save_label"/>
                                </div>
                                <p class="bsi-package-card__desc" t-esc="p.bsi_description"/>
                                <ul class="bsi-package-card__includes">
                                    <li t-foreach="(p.bsi_includes or '').split('\n')" t-as="incl" t-if="incl.strip()"><span class="bsi-accent-text">—</span> <t t-esc="incl"/></li>
                                </ul>
                                <div class="bsi-package-card__footer">
                                    <span class="bsi-strike" t-esc="p.bsi_original_price"/>
                                    <span class="bsi-package-card__price" t-esc="p.bsi_bundle_price"/>
                                    <span class="bsi-pill-btn bsi-pill-btn--accent">Book Package</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </section>

            <!-- Referral -->
            <section t-if="show_referral" class="bsi-container bsi-section bsi-section--top-pad-0">
                <div class="bsi-giftcard bsi-reveal">
                    <div class="bsi-giftcard__ring"/>
                    <div>
                        <p class="bsi-eyebrow">Refer a Friend</p>
                        <h3 class="bsi-h3">Give ₹500, get ₹500.</h3>
                        <p class="bsi-muted">Share your code — you both get credit on their first visit.</p>
                    </div>
                    <a href="/salon/contact" class="bsi-btn bsi-btn--accent bsi-magnetic">Get My Code</a>
                </div>
            </section>
        </t>
    </template>

</odoo>
