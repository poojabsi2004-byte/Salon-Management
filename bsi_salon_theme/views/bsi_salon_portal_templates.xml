<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bsi_portal_my_home_menu" inherit_id="portal.portal_my_home" name="Portal My Home: Appointments entry">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Bookings</t>
                <t t-set="url" t-value="'/my/appointments'"/>
                <t t-set="placeholder_count" t-value="'bsi_appointment_count'"/>
            </t>
        </xpath>
    </template>

    <template id="bsi_portal_appointment_status_badge" name="Appointment Status Badge">
        <span t-if="appointment.bsi_state == 'draft'" class="badge rounded-pill text-bg-info">Draft</span>
        <span t-if="appointment.bsi_state in ('started', 'ended')" class="badge rounded-pill text-bg-warning">In Progress</span>
        <span t-if="appointment.bsi_state == 'completed'" class="badge rounded-pill text-bg-success">Completed</span>
        <span t-if="appointment.bsi_state == 'cancelled'" class="badge rounded-pill text-bg-danger">Cancelled</span>
    </template>

    <template id="bsi_portal_my_appointments" name="My Appointments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Bookings</t>
            </t>
            <t t-if="not appointments">
                <p class="text-muted">You have no bookings yet. <a href="/salon/booking">Book one now</a>.</p>
            </t>
            <t t-else="">
                <table class="table table-hover o_portal_my_doc_table">
                    <thead>
                        <tr class="active">
                            <th>Date</th>
                            <th>Branch</th>
                            <th>Services</th>
                            <th>Artist</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="appointments" t-as="appointment">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/appointments/#{appointment.id}">
                                        <t t-esc="appointment.bsi_preferred_date"/>
                                    </a>
                                </td>
                                <td><t t-esc="appointment.bsi_location_id.name"/></td>
                                <td><t t-esc="', '.join(appointment.bsi_service_ids.mapped('name')) or '-'"/></td>
                                <td><t t-esc="appointment.bsi_artist_id.name or '-'"/></td>
                                <td><t t-call="bsi_salon_theme.bsi_portal_appointment_status_badge"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <t t-call="portal.pager"/>
            </t>
        </t>
    </template>

    <template id="bsi_portal_appointment_detail" name="Appointment Detail">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="False"/>
            <div class="o_portal_navbar d-flex justify-content-between align-items-center mb-3">
                <h3>Booking</h3>
                <t t-call="bsi_salon_theme.bsi_portal_appointment_status_badge"/>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label>Branch</label>
                    <p t-esc="appointment.bsi_location_id.name or '-'"/>
                </div>
                <div class="col-md-6">
                    <label>Date</label>
                    <p t-esc="appointment.bsi_preferred_date or '-'"/>
                </div>
                <div class="col-md-6">
                    <label>Time</label>
                    <p t-esc="appointment.bsi_slot_id.name if appointment.bsi_use_slot else appointment.bsi_time_slot or '-'"/>
                </div>
                <div class="col-md-6">
                    <label>Artist</label>
                    <p t-esc="appointment.bsi_artist_id.name or '-'"/>
                </div>
                <div class="col-md-12">
                    <label>Services</label>
                    <p t-esc="', '.join(appointment.bsi_service_ids.mapped('name')) or '-'"/>
                </div>
            </div>
            <a href="/my/appointments" class="btn btn-secondary mt-3">← Back to Bookings</a>

            <!-- Only once the visit is fully Done (see bsi.salon.booking.request's
                 action_end/account.move auto-completion — "completed" only ever happens once
                 the visit is paid in full) can the customer review it. Resubmitting the same
                 form just edits their existing review (my_review, looked up server-side by
                 this exact appointment + the logged-in customer's own partner — see
                 controllers/portal.py) rather than creating a second one. -->
            <div t-if="appointment.bsi_state == 'completed'" class="mt-4 bsi-review-section">
                <h4 t-esc="'Update Your Review' if my_review else 'Leave a Review'"/>
                <form t-attf-action="/my/appointments/#{appointment.id}/review" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="d-block">Overall Rating</label>
                        <div class="bsi-star-rating">
                            <t t-foreach="[5, 4, 3, 2, 1]" t-as="n">
                                <input type="radio" t-attf-id="bsi_rating_#{n}" name="rating" t-att-value="n"
                                       t-att-checked="'checked' if my_review and int(my_review.rating) == n else None"/>
                                <label t-attf-for="bsi_rating_#{n}">★</label>
                            </t>
                        </div>
                    </div>
                    <div t-if="appointment.bsi_artist_id" class="mb-3">
                        <label class="d-block">Rate <t t-esc="appointment.bsi_artist_id.name"/> (Artist)</label>
                        <div class="bsi-star-rating">
                            <t t-foreach="[5, 4, 3, 2, 1]" t-as="n">
                                <input type="radio" t-attf-id="bsi_artist_rating_#{n}" name="artist_rating" t-att-value="n"
                                       t-att-checked="'checked' if my_review and int(my_review.bsi_artist_rating) == n else None"/>
                                <label t-attf-for="bsi_artist_rating_#{n}">★</label>
                            </t>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="bsi_review_feedback">Comment</label>
                        <textarea id="bsi_review_feedback" name="feedback" class="form-control" rows="3"
                                  t-esc="my_review.feedback if my_review else ''"/>
                    </div>
                    <button type="submit" class="btn btn-primary" t-esc="'Update Review' if my_review else 'Submit Review'"/>
                    <p t-if="my_review and my_review.rated_on" class="text-muted mt-2 mb-0">
                        Rated on <t t-esc="my_review.rated_on"/>
                    </p>
                </form>
            </div>
        </t>
    </template>

</odoo>
