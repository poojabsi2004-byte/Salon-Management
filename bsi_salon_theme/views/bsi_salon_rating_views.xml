<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The stock rating.rating form hides `rating` entirely (see rating_rating_view_form in
         core) and has no field/widget for bsi_artist_id/bsi_artist_rating at all, so a
         backend "Add Review"/"Ratings" click landed on a form no one could actually fill in.
         This is a dedicated replacement, not a global inherit of the stock form — that would
         leak these salon-only fields into every other app's ratings (Project, Helpdesk, ...). -->
    <record id="bsi_salon_rating_view_form" model="ir.ui.view">
        <field name="name">rating.rating.form.bsi.salon</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <form string="Review">
                <sheet>
                    <group>
                        <group string="Review">
                            <!-- bsi_appointment_id is a friendly stand-in for the native
                                 res_model_id/res_id pair (see models/rating_rating.py) —
                                 opened from an appointment's own "Add Review" button it
                                 arrives pre-filled via context; created fresh from this
                                 menu's own "New" button, it's how a review actually gets
                                 linked to one at all. -->
                            <field name="bsi_appointment_id"/>
                            <!-- Customer is implied by the Appointment (one customer per
                                 booking) — kept in the arch so it still gets set (see
                                 _onchange_bsi_appointment_id), just not shown twice. -->
                            <field name="partner_id" string="Customer" invisible="1"/>
                            <field name="bsi_rating_stars" widget="priority" string="Overall Rating"/>
                            <field name="feedback" placeholder="Comment..."/>
                            <field name="rated_on" readonly="1"/>
                        </group>
                        <group string="Artist">
                            <field name="bsi_artist_id"/>
                            <field name="bsi_artist_rating_stars" widget="priority" string="Artist Rating"/>
                        </group>
                    </group>
                    <field name="res_model_id" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="consumed" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stock rating.rating list view is create="false"/edit="false" (ratings are normally
         only ever created through whatever they're rating) — this menu is meant to let staff
         log/manage salon reviews directly, so it needs its own, genuinely creatable list. -->
    <record id="bsi_salon_rating_view_list" model="ir.ui.view">
        <field name="name">rating.rating.list.bsi.salon</field>
        <field name="model">rating.rating</field>
        <field name="arch" type="xml">
            <list string="Reviews &amp; Ratings">
                <field name="bsi_appointment_id" string="Appointment"/>
                <field name="partner_id" string="Customer"/>
                <field name="bsi_rating_stars" widget="priority" string="Overall"/>
                <field name="bsi_artist_id" string="Artist"/>
                <field name="bsi_artist_rating_stars" widget="priority" string="Artist Rating"/>
                <field name="feedback" string="Comment"/>
                <field name="rated_on"/>
            </list>
        </field>
    </record>

    <record id="bsi_salon_rating_action" model="ir.actions.act_window">
        <field name="name">Reviews &amp; Ratings</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'bsi.salon.booking.request')]</field>
        <field name="context">{'default_consumed': True}</field>
    </record>
    <!-- ir.actions.act_window._compute_views builds the final view order from view_ids
         FIRST, in their own sequence, and only falls back to view_mode's string order for
         whatever mode isn't already covered — so both the list and the form need their own
         explicit record here (list before form), or the one left implicit would jump ahead
         of the one that's explicit regardless of view_mode's own ordering. -->
    <record id="bsi_salon_rating_action_view_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="bsi_salon_rating_view_list"/>
        <field name="act_window_id" ref="bsi_salon_rating_action"/>
    </record>
    <record id="bsi_salon_rating_action_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="bsi_salon_rating_view_form"/>
        <field name="act_window_id" ref="bsi_salon_rating_action"/>
    </record>

    <!-- Header group under Configuration, same pattern as Booking Setup / Membership. -->
    <menuitem id="bsi_salon_feedback_menu" name="Feedback" parent="bsi_salon_content_menu" sequence="30"/>
    <menuitem id="bsi_salon_rating_menu" name="Reviews &amp; Ratings" parent="bsi_salon_feedback_menu"
              action="bsi_salon_rating_action" sequence="10"/>

</odoo>
