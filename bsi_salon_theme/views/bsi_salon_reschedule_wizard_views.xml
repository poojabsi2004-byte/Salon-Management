<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="bsi_salon_reschedule_wizard_view_form" model="ir.ui.view">
        <field name="name">bsi.salon.reschedule.wizard.form</field>
        <field name="model">bsi.salon.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="lead_id" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    <field name="conflict_reason" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <field name="customer_name"/>
                    <field name="customer_email"/>
                    <field name="artist_id"/>
                    <field name="requested_date"/>
                </group>
                <group>
                    <field name="available_slot_ids" widget="many2many_tags" readonly="1"
                           string="Other slots free that day"/>
                    <field name="suggested_slot_id"/>
                </group>
                <footer>
                    <button name="action_send_reschedule_email" string="Send Reschedule Email"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
