<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="bsi_sale_order_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.bsi.salon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="bsi_appointment_id" invisible="1"/>
                <field name="bsi_appointment_state" invisible="1"/>
                <field name="bsi_rating_count" invisible="1" groups="base.group_user"/>
                <field name="bsi_rating_avg" invisible="1" groups="base.group_user"/>
            </field>

            <!-- Review &amp; Rating — only shown once the appointment is Done (which itself
                 only happens once the invoice is fully paid), matching the same gating as
                 the appointment's own Reviews &amp; Ratings tab and the portal review form. -->
            <xpath expr="//header" position="inside">
                <button name="action_bsi_add_appointment_review" type="object" string="Add Review"
                        invisible="not bsi_appointment_id or bsi_appointment_state != 'completed'"/>
            </xpath>

            <!-- Appointment details shown as read-only fields in the quotation header
                 (instead of note lines inside Order Lines) so they read like part of the
                 quotation itself rather than a line in the product list. -->
            <group name="partner_details" position="inside">
                <field name="bsi_location_id" string="Branch" invisible="not bsi_appointment_id"/>
                <field name="bsi_artist_id" string="Stylist" invisible="not bsi_appointment_id"/>
                <field name="bsi_chair_ids" string="Chair(s)" widget="many2many_tags"
                       invisible="not bsi_appointment_id"/>
            </group>
            <group name="order_details" position="inside">
                <field name="bsi_preferred_date" string="Appointment Date" invisible="not bsi_appointment_id"/>
                <field name="bsi_appointment_time" string="Appointment Time" invisible="not bsi_appointment_id"/>
            </group>

            <!-- Only shown once a membership discount was actually verified and applied on
                 the originating appointment (see bsi_salon_booking_mixin.py) — the plan's
                 own perks (bsi.salon.membership.bsi_perks) are surfaced here too, so
                 whoever is reviewing/confirming the quotation can see at a glance what the
                 customer's plan entitles them to, not just the discount percentage. -->
            <group name="sale_header" position="after">
                <group name="bsi_membership" string="Membership" invisible="not bsi_membership_id">
                    <field name="bsi_membership_id" string="Plan"/>
                    <field name="bsi_discount_percent" string="Discount %"/>
                    <field name="bsi_membership_perks" string="Plan Includes"/>
                </group>
            </group>

            <!-- Distinct from the native "Disc.%" column right before it — this one shows
                 specifically how much of that discount is the customer's membership, and
                 editing it here drives the real "discount" field via onchange (see
                 sale_order.py:SaleOrderLine), so the totals recompute exactly like a native
                 discount edit would. -->
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="after">
                <field name="bsi_membership_discount_percent" string="Membership Disc.%"
                       groups="sale.group_discount_per_so_line" width="70px" optional="show"/>
            </xpath>

            <div name="button_box" position="inside">
                <button name="action_bsi_view_appointment" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        invisible="not bsi_appointment_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Booking</span>
                    </div>
                </button>
                <button name="action_bsi_open_appointment_ratings" type="object" groups="base.group_user"
                        class="oe_stat_button" invisible="bsi_rating_count == 0">
                    <i class="fa fa-fw o_button_icon fa-smile-o text-success" invisible="bsi_rating_avg &lt; 3.66" title="Happy"/>
                    <i class="fa fa-fw o_button_icon fa-meh-o text-warning" invisible="bsi_rating_avg &lt; 2.33 or bsi_rating_avg &gt;= 3.66" title="Neutral"/>
                    <i class="fa fa-fw o_button_icon fa-frown-o text-danger" invisible="bsi_rating_avg &gt;= 2.33" title="Unhappy"/>
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Reviews</span>
                    </div>
                </button>
            </div>

        </field>
    </record>

</odoo>
