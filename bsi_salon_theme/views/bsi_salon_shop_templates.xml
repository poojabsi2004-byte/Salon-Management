<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bsi_page_shop" name="Salon Theme: Shop">
        <t t-call="bsi_salon_theme.bsi_layout">

            <!-- Hero -->
            <section class="bsi-container bsi-page-hero bsi-section--bordered-bottom bsi-reveal">
                <p class="bsi-eyebrow">Retail &amp; Take-Home Care</p>
                <div class="bsi-page-hero__row">
                    <h1 class="bsi-h1">Shop the<br/><em>salon shelf.</em></h1>
                    <p class="bsi-page-hero__sub">Professional hair, skin and styling products our stylists actually use — delivered to your door.</p>
                </div>
            </section>

            <!-- Toolbar: category pills + search + sort -->
            <div class="bsi-filter-bar" id="bsiShopToolbar">
                <div class="bsi-container bsi-filter-bar__inner">
                    <a t-att-href="'/salon/shop?' + keep_query('*', category='', page=1)"
                       t-attf-class="bsi-filter-btn #{not selected_category and 'bsi-filter-btn--active' or ''}">All</a>
                    <a t-foreach="categories" t-as="c"
                       t-att-href="'/salon/shop?' + keep_query('*', category=c.id, page=1)"
                       t-attf-class="bsi-filter-btn #{selected_category == c.id and 'bsi-filter-btn--active' or ''}"
                       t-esc="c.name"/>
                    <span class="bsi-filter-bar__count">
                        <t t-esc="total"/> <t t-esc="total == 1 and 'product' or 'products'"/>
                    </span>
                </div>
                <form method="get" action="/salon/shop" class="bsi-container bsi-shop-toolbar">
                    <input type="hidden" name="category" t-att-value="selected_category or ''"/>
                    <label class="bsi-shop-toolbar__search">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                        <input type="text" name="search" placeholder="Search products…" t-att-value="search"/>
                    </label>
                    <select name="sort" id="bsiShopSort" class="bsi-shop-toolbar__sort">
                        <option value="name" t-att-selected="sort == 'name' or None">Name: A–Z</option>
                        <option value="newest" t-att-selected="sort == 'newest' or None">Newest</option>
                        <option value="price_asc" t-att-selected="sort == 'price_asc' or None">Price: Low to High</option>
                        <option value="price_desc" t-att-selected="sort == 'price_desc' or None">Price: High to Low</option>
                    </select>
                    <button type="submit" class="bsi-pill-btn">Apply</button>
                </form>
            </div>

            <!-- Grid -->
            <div class="bsi-container bsi-section">
                <div t-if="products" class="bsi-grid-4">
                    <div t-foreach="products" t-as="p" class="bsi-card bsi-card--hover bsi-shop-card bsi-reveal">
                        <a t-attf-href="/shop/#{slug(p)}" class="bsi-shop-card__media">
                            <img t-att-src="'/web/image/product.template/%s/image_512' % p.id" t-att-alt="p.name" loading="lazy"/>
                        </a>
                        <button type="button" class="bsi-shop-card__quick-add"
                                t-att-data-product-id="p.product_variant_id.id"
                                t-att-data-template-id="p.id"
                                aria-label="Add to cart">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        </button>
                        <div class="bsi-shop-card__body">
                            <span t-if="p.public_categ_ids" class="bsi-shop-card__cat" t-esc="p.public_categ_ids[0].name"/>
                            <h3><a t-attf-href="/shop/#{slug(p)}" t-esc="p.name"/></h3>
                            <div class="bsi-shop-card__price">
                                <span t-field="p.list_price" t-options="{'widget': 'monetary', 'display_currency': p.currency_id}"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div t-else="" class="bsi-shop-empty">
                    <p>No products match these filters.</p>
                    <a href="/salon/shop" class="bsi-pill-btn">Clear filters</a>
                </div>

                <!-- Pagination -->
                <div t-if="pages > 1" class="bsi-shop-pagination">
                    <a t-if="page > 1" t-att-href="'/salon/shop?' + keep_query('*', page=page - 1)" class="bsi-pill-btn">← Previous</a>
                    <span class="bsi-shop-pagination__status">Page <t t-esc="page"/> of <t t-esc="pages"/></span>
                    <a t-if="page &lt; pages" t-att-href="'/salon/shop?' + keep_query('*', page=page + 1)" class="bsi-pill-btn">Next →</a>
                </div>
            </div>

            <div class="bsi-shop-toast" id="bsiShopToast" role="status" aria-live="polite"></div>
        </t>
    </template>

</odoo>
