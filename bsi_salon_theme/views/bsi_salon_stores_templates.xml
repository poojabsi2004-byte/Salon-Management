<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bsi_page_stores" name="Salon Theme: Stores">
        <t t-call="bsi_salon_theme.bsi_layout">

            <!-- Hero -->
            <section class="bsi-container bsi-page-hero bsi-section--bordered-bottom bsi-reveal">
                <p class="bsi-eyebrow">Store Network</p>
                <h1 class="bsi-h1">Find a branch on<br/><em>the map.</em></h1>
            </section>

            <!-- City tabs -->
            <div class="bsi-container bsi-section--top-pad-0" style="padding-top:2rem;">
                <div class="bsi-city-tabs" id="bsiCityTabs">
                    <a t-foreach="cities" t-as="c" t-attf-href="/salon/our-salons?city=#{c}"
                       t-attf-class="bsi-city-tab #{c == selected_city and 'bsi-city-tab--active' or ''}" t-esc="c"/>
                </div>
            </div>

            <!-- Map + rail -->
            <section class="bsi-container bsi-section">
                <div class="bsi-stores-layout2">
                    <div class="bsi-mini-map">
                        <div class="bsi-mini-map__road bsi-mini-map__road--h"/>
                        <div class="bsi-mini-map__road bsi-mini-map__road--v"/>
                        <div class="bsi-mini-map__block bsi-mini-map__block--1"/>
                        <div class="bsi-mini-map__block bsi-mini-map__block--2"/>
                        <div class="bsi-mini-map__you">
                            <span class="bsi-mini-map__you-dot"/>
                            <span class="bsi-mini-map__you-label">YOU</span>
                        </div>
                        <a t-foreach="locations" t-as="loc"
                           t-attf-href="#loc-#{loc.id}"
                           t-attf-style="left:#{loc.bsi_map_x}%%;top:#{loc.bsi_map_y}%%;"
                           t-attf-class="bsi-mini-map__pin #{loc.bsi_wait_minutes == 0 and 'bsi-mini-map__pin--live' or ''}"
                           t-att-data-loc-id="loc.id">
                            <span class="bsi-mini-map__pin-dot"/>
                            <span class="bsi-mini-map__pin-label" t-esc="loc.name"/>
                        </a>
                        <div class="bsi-mini-map__status">
                            <span t-esc="selected_city"/> Map
                            <span class="bsi-mini-map__status-live">● <t t-esc="len(locations.filtered(lambda l: l.bsi_wait_minutes == 0))"/> open now</span>
                        </div>
                    </div>

                    <div class="bsi-stores-rail">
                        <a t-foreach="locations" t-as="loc" t-attf-id="loc-#{loc.id}"
                           t-attf-href="/salon/booking?location_id=#{loc.id}"
                           class="bsi-stores-rail__item bsi-reveal" t-att-data-loc-id="loc.id">
                            <div t-attf-class="bsi-stores-rail__badge #{loc.bsi_wait_minutes == 0 and 'bsi-stores-rail__badge--live' or ''}" t-esc="loc.name[0]"/>
                            <div class="bsi-stores-rail__body">
                                <div class="bsi-stores-rail__head">
                                    <span t-esc="loc.name"/>
                                    <span class="bsi-stores-rail__rating"><t t-esc="loc.bsi_rating"/>★</span>
                                </div>
                                <div class="bsi-muted-sm" t-esc="loc.bsi_address"/>
                                <div class="bsi-stores-rail__foot">
                                    <span t-attf-class="bsi-wait-pill #{loc.bsi_wait_minutes == 0 and 'bsi-wait-pill--live' or (loc.bsi_wait_minutes &lt;= 10 and 'bsi-wait-pill--soon' or 'bsi-wait-pill--busy')}">
                                        <t t-if="loc.bsi_wait_minutes == 0">Walk-ins welcome</t>
                                        <t t-else="1"><t t-esc="loc.bsi_wait_minutes"/> min wait</t>
                                    </span>
                                    <span class="bsi-muted-sm">Mon–Fri <t t-esc="loc.bsi_hours_weekdays"/></span>
                                </div>
                                <div t-if="loc.bsi_service_ids" class="bsi-tag-list bsi-stores-rail__services">
                                    <span t-foreach="loc.bsi_service_ids[:4]" t-as="svc" class="bsi-tag-outline" t-esc="svc.name"/>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </section>

            <!-- All locations strip -->
            <section class="bsi-section-alt">
                <div class="bsi-container">
                    <h2 class="bsi-h3 bsi-reveal">All locations at a glance.</h2>
                    <div class="bsi-grid-6">
                        <a t-foreach="all_locations" t-as="loc"
                           t-attf-href="/salon/our-salons?city=#{loc.bsi_city}"
                           class="bsi-card bsi-card--hover bsi-store-chip bsi-reveal">
                            <div class="bsi-store-chip__name" t-esc="loc.name"/>
                            <div class="bsi-store-chip__meta" t-esc="loc.bsi_city"/>
                            <div t-if="loc.bsi_flagship" class="bsi-store-chip__flagship">Flagship</div>
                        </a>
                    </div>
                </div>
            </section>
        </t>
    </template>

</odoo>
