<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bsi_page_stylists" name="Salon Theme: Stylists">
        <t t-call="bsi_salon_theme.bsi_layout">

            <!-- Hero: split, echoing the About page's editorial hero rather than
                 a bare centered title — a featured artist photo faces the copy,
                 with the roster size doing double duty as a proof stat. -->
            <section class="bsi-section bsi-container bsi-stylists-hero">
                <div class="bsi-stylists-hero__col bsi-reveal">
                    <p class="bsi-eyebrow">Our Team</p>
                    <h1 class="bsi-h1">The hands<br/>behind <em>every chair.</em></h1>
                    <p class="bsi-lead">Every Enrich stylist trains through the same in-house academy before ever touching a client — so the artist you meet at any of our 100+ branches carries the same standard.</p>
                    <div class="bsi-why__proof">
                        <strong><span class="bsi-counter" t-att-data-count="len(team_members)" data-suffix="+">0</span></strong>
                        <span>certified artists across hair, colour, skin and bridal</span>
                    </div>
                </div>
                <div class="bsi-stylists-hero__col bsi-stylists-hero__image bsi-reveal bsi-reveal--right" t-if="team_members">
                    <img t-att-src="('/web/image/bsi.salon.team.member/%s/bsi_image' % team_members[0].id) if team_members[0].bsi_image else (team_members[0].bsi_image_url or 'https://images.unsplash.com/photo-1522337660859-02fbefca4702?w=700&amp;h=800&amp;fit=crop&amp;auto=format')" t-att-alt="team_members[0].name"/>
                    <div class="bsi-stylists-hero__tag">
                        <span class="bsi-stylists-hero__tag-name" t-esc="team_members[0].name"/>
                        <span class="bsi-stylists-hero__tag-role" t-esc="team_members[0].bsi_specialty"/>
                    </div>
                </div>
            </section>

            
            <!-- Roster: an offset masonry, not a flush grid-3 — every second and
                 third card is nudged down so the row reads as hand-arranged. -->
            <section class="bsi-section bsi-container">
                <div class="bsi-section__head bsi-reveal">
                    <div>
                        <p class="bsi-eyebrow">The Roster</p>
                        <h2 class="bsi-h2">Meet the artists.</h2>
                    </div>
                    <a href="/salon/booking" class="bsi-link-arrow">Book a stylist →</a>
                </div>
                <div class="bsi-stylists-grid">
                    <div t-foreach="team_members" t-as="member" class="bsi-card bsi-card--hover bsi-stylist-card bsi-reveal">
                        <img t-att-src="('/web/image/bsi.salon.team.member/%s/bsi_image' % member.id) if member.bsi_image else (member.bsi_image_url or 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?w=300&amp;h=300&amp;fit=crop&amp;auto=format')" t-att-alt="member.name" class="bsi-stylist-card__photo"/>
                        <div class="bsi-stylist-card__name" t-esc="member.name"/>
                        <div class="bsi-stylist-card__specialty" t-esc="member.bsi_specialty"/>
                        <div class="bsi-muted-sm">Since <t t-esc="member.bsi_since_year"/> · <t t-esc="member.bsi_role"/></div>
                        <div class="bsi-stylist-card__stars">★★★★★</div>
                    </div>
                </div>
            </section>

            <section class="bsi-section bsi-section--bordered-top bsi-section__center">
                <h2 class="bsi-h2">Book time with<br/><em>one of our artists.</em></h2>
                <a href="/salon/booking" class="bsi-btn bsi-btn--accent bsi-btn--lg bsi-magnetic">Book Now</a>
            </section>
        </t>
    </template>

</odoo>
