<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══ Shared head assets: fonts + dark-mode flash guard ═══
         Used by bsi_layout (marketing pages) and by bsi_checkout_layout_inherit
         (cart/checkout/payment) so both read the same saved theme before first
         paint instead of only one of them applying it. -->
    <template id="bsi_head_assets" name="Salon Theme: Head Assets">
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
        <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&amp;family=Manrope:wght@400;500;600;700;800&amp;family=Alex+Brush&amp;display=swap" rel="stylesheet"/>
        <script>
            (function () {
                try {
                    if (localStorage.getItem('bsi_salon_theme') === 'dark') {
                        document.documentElement.setAttribute('data-theme', 'dark');
                    }
                } catch (e) {}
            })();
        </script>
    </template>

    <!-- ═══ Shared page shell: fonts, dark-mode flash guard, navbar, footer ═══ -->
    <template id="bsi_layout" name="Salon Theme: Layout">
        <t t-set="head">
            <t t-call="bsi_salon_theme.bsi_head_assets"/>
        </t>
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="bsi-salon" id="bsi-salon-root">
                <div class="bsi-progress" aria-hidden="true"><div class="bsi-progress__bar" id="bsiProgressBar"/></div>
                <t t-call="bsi_salon_theme.bsi_navbar"/>
                <main class="bsi-salon-main">
                    <t t-out="0"/>
                </main>
                <t t-call="bsi_salon_theme.bsi_footer"/>
            </div>
        </t>
    </template>

    <!-- ═══ Navbar ═══ -->
    <template id="bsi_navbar" name="Salon Theme: Navbar">
        <nav class="bsi-nav" id="bsiNav">
            <div class="bsi-nav__inner">
                <a href="/salon" class="bsi-nav__logo">
                    <span class="bsi-nav__logo-script">enrich</span>
                    <span class="bsi-nav__logo-tag">love begins with you</span>
                </a>

                <div class="bsi-nav__links">
                    <a href="/salon" t-attf-class="bsi-nav__link #{active_page == 'home' and 'bsi-nav__link--active' or ''}">Home</a>
                    <a href="/salon/our-salons" t-attf-class="bsi-nav__link #{active_page == 'stores' and 'bsi-nav__link--active' or ''}">Stores</a>
                    <a href="/salon/booking" t-attf-class="bsi-nav__link #{active_page == 'booking' and 'bsi-nav__link--active' or ''}">Book Now</a>
                    <a href="/salon/packages" t-attf-class="bsi-nav__link #{active_page == 'packages' and 'bsi-nav__link--active' or ''}">Membership</a>
                    <a href="/salon/offers" t-attf-class="bsi-nav__link #{active_page == 'offers' and 'bsi-nav__link--active' or ''}">Services</a>
                    <a href="/salon/shop" t-attf-class="bsi-nav__link #{active_page == 'shop' and 'bsi-nav__link--active' or ''}">Shop</a>
                    <a href="/salon/stylists" t-attf-class="bsi-nav__link #{active_page == 'stylists' and 'bsi-nav__link--active' or ''}">Stylists</a>
                    <a href="/salon/about" t-attf-class="bsi-nav__link #{active_page == 'about' and 'bsi-nav__link--active' or ''}">About</a>
                    <a href="/salon/contact" t-attf-class="bsi-nav__link #{active_page == 'contact' and 'bsi-nav__link--active' or ''}">Contact</a>
                </div>

                <div class="bsi-nav__actions">
                    <a href="/shop/cart" class="bsi-nav__cart" id="bsiNavCart" aria-label="Cart">
                        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                        <span class="bsi-nav__cart-count" id="bsiNavCartCount"
                              t-att-hidden="not request.cart.cart_quantity and '1' or None"
                              t-esc="request.cart.cart_quantity"/>
                    </a>
                    <button type="button" class="bsi-theme-toggle" id="bsiThemeToggle" aria-label="Toggle dark mode">
                        <span class="bsi-theme-toggle__thumb" id="bsiThemeThumb">☀</span>
                    </button>
                    <!-- Internal staff only (not shown to public/portal visitors) — jumps
                         straight to the Salon Management dashboard. -->
                    <a t-if="request.env.user._is_internal()" href="/salon/dashboard" target="_blank"
                       class="bsi-btn bsi-btn--outline bsi-nav__dashboard-link">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                        </svg>
                        <span>Dashboard</span>
                    </a>
                    <a href="/salon/booking" class="bsi-btn bsi-btn--accent bsi-nav__cta">Book Now</a>
                    <button type="button" class="bsi-nav__burger" id="bsiBurger" aria-label="Menu">
                        <span/><span/><span/>
                    </button>
                </div>
            </div>

            <div class="bsi-nav__mobile" id="bsiMobileMenu">
                <a href="/salon" t-attf-class="bsi-nav__mobile-link #{active_page == 'home' and 'bsi-nav__link--active' or ''}">Home</a>
                <a href="/salon/our-salons" t-attf-class="bsi-nav__mobile-link #{active_page == 'stores' and 'bsi-nav__link--active' or ''}">Stores</a>
                <a href="/salon/booking" t-attf-class="bsi-nav__mobile-link #{active_page == 'booking' and 'bsi-nav__link--active' or ''}">Book Now</a>
                <a href="/salon/packages" t-attf-class="bsi-nav__mobile-link #{active_page == 'packages' and 'bsi-nav__link--active' or ''}">Membership</a>
                <a href="/salon/offers" t-attf-class="bsi-nav__mobile-link #{active_page == 'offers' and 'bsi-nav__link--active' or ''}">Services</a>
                <a href="/salon/shop" t-attf-class="bsi-nav__mobile-link #{active_page == 'shop' and 'bsi-nav__link--active' or ''}">Shop</a>
                <a href="/salon/stylists" t-attf-class="bsi-nav__mobile-link #{active_page == 'stylists' and 'bsi-nav__link--active' or ''}">Stylists</a>
                <a href="/salon/about" t-attf-class="bsi-nav__mobile-link #{active_page == 'about' and 'bsi-nav__link--active' or ''}">About</a>
                <a href="/salon/contact" t-attf-class="bsi-nav__mobile-link #{active_page == 'contact' and 'bsi-nav__link--active' or ''}">Contact</a>
                <a t-if="request.env.user._is_internal()" href="/salon/dashboard" target="_blank" class="bsi-nav__mobile-link">Dashboard</a>
                <a href="/salon/booking" class="bsi-btn bsi-btn--accent bsi-nav__mobile-cta">Book Now</a>
            </div>
        </nav>
    </template>

    <!-- ═══ Footer ═══ -->
    <template id="bsi_footer" name="Salon Theme: Footer">
        <footer class="bsi-footer">
            <!-- footer backdrop removed per request -->

            <div class="bsi-footer__cta">
                <div class="bsi-footer__cta-copy">
                    <p class="bsi-eyebrow bsi-eyebrow--on-accent">Ready when you are</p>
                    <h3 class="bsi-h3">Book your next appointment.</h3>
                </div>
                <a href="/salon/booking" class="bsi-btn bsi-btn--accent bsi-magnetic">Book Now →</a>
            </div>

            <div class="bsi-footer__grid">
                <div class="bsi-footer__brand">
                    <div class="bsi-footer__logo">enrich</div>
                    <p class="bsi-footer__tagline-script">love begins with you</p>
                    <p class="bsi-footer__tagline">India's leading salon chain since 1997 — hair, skin, makeup and wellness across 100+ locations.</p>
                    <div class="bsi-footer__social">
                        <a href="#" aria-label="Instagram" class="bsi-footer__social-btn bsi-magnetic">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
                        </a>
                        <a href="#" aria-label="Facebook" class="bsi-footer__social-btn bsi-magnetic">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 8.5h2.5V5h-2.5C12.9 5 11.5 6.6 11.5 9v2.5H9V15h2.5v6H15v-6h2.3l.5-3.5H15V9c0-.4.2-.5.6-.5Z"/></svg>
                        </a>
                        <a href="#" aria-label="YouTube" class="bsi-footer__social-btn bsi-magnetic">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="6" width="18" height="12" rx="4"/><path d="M10.5 9.5v5l4.5-2.5-4.5-2.5Z" fill="currentColor" stroke="none"/></svg>
                        </a>
                    </div>
                </div>
                <div>
                    <div class="bsi-eyebrow">Navigate</div>
                    <div class="bsi-footer__links">
                        <a href="/salon">Home</a>
                        <a href="/salon/our-salons">Stores</a>
                        <a href="/salon/booking">Book Now</a>
                        <a href="/salon/packages">Membership</a>
                        <a href="/salon/offers">Services</a>
                        <a href="/salon/stylists">Stylists</a>
                        <a href="/salon/about">About</a>
                        <a href="/salon/contact">Contact</a>
                    </div>
                </div>
                <div>
                    <div class="bsi-eyebrow">Locations</div>
                    <div class="bsi-footer__locations">
                        <t t-foreach="request.env['bsi.salon.location'].sudo().search([], limit=8)" t-as="loc">
                            <a href="/salon/our-salons" class="bsi-footer__location-link" t-esc="loc.name"/>
                        </t>
                    </div>
                </div>
                <div>
                    <div class="bsi-eyebrow">Contact</div>
                    <div class="bsi-footer__contact">
                        <a href="tel:18002665300" class="bsi-footer__contact-row">
                            <span class="bsi-footer__contact-icon">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2 4.5 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z"/></svg>
                            </span>
                            <span>1800-266-5300 <em>(Toll Free)</em></span>
                        </a>
                        <a href="mailto:care@enrichbeauty.com" class="bsi-footer__contact-row bsi-accent-text">
                            <span class="bsi-footer__contact-icon">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M4 7l8 6 8-6"/></svg>
                            </span>
                            <span>care@enrichbeauty.com</span>
                        </a>
                        <div class="bsi-footer__contact-row bsi-footer__hours">
                            <span class="bsi-footer__contact-icon">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
                            </span>
                            <span>Mon–Sun: 10:00 – 20:00</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bsi-footer__bottom">
                <span>© 2026 Enrich Hair and Skin Solutions Pvt. Ltd. All rights reserved.</span>
                <span>Ahmedabad · Pune · Mumbai · Bengaluru · Vadodara · Surat</span>
                <button type="button" class="bsi-footer__to-top bsi-magnetic" id="bsiFooterToTop" aria-label="Back to top">↑</button>
            </div>
        </footer>
    </template>

    <!-- ═══ Decorative salon-tools line-art divider (neutralized) ═══ -->
    <template id="bsi_tools_divider" name="Salon Theme: Tools Divider">
        <div class="bsi-tools-divider" aria-hidden="true"></div>
    </template>

</odoo>
