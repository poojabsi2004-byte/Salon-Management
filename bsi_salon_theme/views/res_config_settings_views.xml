<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A dedicated "Salon Management" tab in Settings, one toggle per website section —
         each is a plain ir.config_parameter-backed boolean (see models/res_config_settings.py),
         read directly by the /salon/packages controller to decide what to render. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.bsi.salon</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Salon Management" string="Salon Management" name="bsi_salon_theme">
                    <block title="Website Visibility"
                           help="Show or hide each of these sections on the website Packages page (/salon/packages) — no code involved, just a display toggle.">
                        <setting id="bsi_show_membership_setting" string="Membership"
                                 help="Show the Membership plans section">
                            <field name="bsi_show_membership"/>
                        </setting>
                        <setting id="bsi_show_packages_setting" string="Packages"
                                 help="Show the Bundle Packages section">
                            <field name="bsi_show_packages"/>
                        </setting>
                        <setting id="bsi_show_loyalty_points_setting" string="Loyalty Points"
                                 help="Show the Loyalty Wallet section">
                            <field name="bsi_show_loyalty_points"/>
                        </setting>
                        <setting id="bsi_show_referral_setting" string="Refer a Friend"
                                 help="Show the Refer a Friend section">
                            <field name="bsi_show_referral"/>
                        </setting>
                        <setting id="bsi_show_gift_card_setting" string="Gift Card"
                                 help="Show the Gift Cards section">
                            <field name="bsi_show_gift_card"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Deep-links straight into the "Salon Management" app section above (see
         base_setup's own action_general_configuration for the same context={'module': ...}
         pattern) — used by the dashboard sidebar's gear icon instead of falling through to
         whatever the Configuration menu's first child happens to be. -->
    <record id="bsi_salon_config_settings_action" model="ir.actions.act_window">
        <field name="name">Salon Management Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'bsi_salon_theme', 'bin_size': False}</field>
    </record>

</odoo>
